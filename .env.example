# Clerk (required): https://dashboard.clerk.com → API keys.
# Signing in is required to create a room.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Foursquare Places API (optional). Without it, 15 built-in mock restaurants are served.
FOURSQUARE_API_KEY=

# Upstash Redis (required on Vercel, optional locally). Stores rooms so they are
# shared across serverless functions. Without it, rooms live in process memory.
# Connecting Upstash from Vercel's Storage tab sets these (or KV_REST_API_URL/TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
